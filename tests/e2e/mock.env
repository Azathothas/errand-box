# errand's settings for sessions against the Discord stand-in
# (discord-mock, T-035). The ids are the ones its default seed makes: the
# channel `errand-test`, and the person `amelia`, who may drive sessions.
# Pass with `errand-box setup --env`, beside mock-creds.env.
#
# The provider below answers nothing: a session starts, its guest and agent
# run, and the first model turn fails. For a model turn, set the
# ERRAND_PROVIDER_* lines and ERRAND_MODEL to a real gateway, and its key in
# the creds file.
ERRAND_CHANNEL_ID=1190000000000000020
ERRAND_ALLOWED_USER_IDS=1190000000000000100
ERRAND_OPERATOR_USER_IDS=1190000000000000100
ERRAND_PROVIDER=gateway
ERRAND_PROVIDER_BASE_URL=https://gateway.invalid/v1
ERRAND_PROVIDER_KIND=openai
ERRAND_PROVIDER_CREDENTIAL_NAME=PROVIDER_KEY
ERRAND_MODEL=test-model
ERRAND_EGRESS_ALLOW=
