# The chat token of the Discord stand-in, and a provider key that is not
# one. Neither is a secret: errand sends a token that begins with `mock.`
# only to a stand-in on a loopback address (errand/src/chat/endpoint.rs).
# Keep the mode 0600 anyway, as for a real creds file.
ERRAND_CHAT_TOKEN=mock.bot-token
ERRAND_PROVIDER_CREDENTIAL=not-a-key
