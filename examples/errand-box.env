# errand's settings that are not secret. Pass with `errand-box setup --env`.
# Required: ERRAND_CHANNEL_ID, ERRAND_ALLOWED_USER_IDS, ERRAND_PROVIDER.

# The one chat channel errand serves, and who may drive sessions (comma list).
ERRAND_CHANNEL_ID=
ERRAND_ALLOWED_USER_IDS=
ERRAND_OPERATOR_USER_IDS=

# The model provider: a name, its endpoint, and the variable kage reads the
# key from. With a base URL, errand's broker keeps the key on the host.
ERRAND_PROVIDER=
ERRAND_PROVIDER_BASE_URL=
ERRAND_PROVIDER_KIND=openai
ERRAND_PROVIDER_CREDENTIAL_NAME=
ERRAND_MODEL=

# Needed only with ERRAND_GITHUB_TOKEN in creds.env.
ERRAND_GITHUB_USER_NAME=
ERRAND_GITHUB_USER_EMAIL=

# Hosts a session may reach through errand's broker (comma list). Empty for
# errand-box's default list (github.com, pypi.org, crates.io and the rest).
# Setting this REPLACES that list; to keep the defaults and add to them, leave
# this empty and set ERRAND_EGRESS_ALLOW_EXTRA instead.
ERRAND_EGRESS_ALLOW=
# Hosts to add on top of whatever ERRAND_EGRESS_ALLOW leaves in force (comma
# list). Use this when you only need one more host than the defaults.
ERRAND_EGRESS_ALLOW_EXTRA=
